
﻿@model VentaMusical.Models.ViewModels.Albumes.EditarAlbum
@{
    ViewBag.Title = "Editar Álbum";
}

<h2>@ViewBag.Title</h2>
<hr />

@using (Html.BeginForm("Edit", "Albumes", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.CodigoAlbum) @* Campo oculto para saber qué ID editar *@
    <div class="form-group">
        <label class="control-label col-md-2">Código de Álbum</label>
        <div class="col-md-10">
            <p class="form-control-static">@Model.CodigoAlbum</p>
        </div>
    </div>
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.NombreAlbum, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NombreAlbum, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.NombreAlbum, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.AnoLanzamiento, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.AnoLanzamiento, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.AnoLanzamiento, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.CodigoArtista, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("CodigoArtista", (SelectList)ViewBag.CodigoArtista, "Seleccione un artista", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.CodigoArtista, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Portada Actual</label>
            <div class="col-md-10">
                <img src="@Url.Content("~/Content/Imagenes/Albumes/" + Model.ImagenExistente)" alt="Portada Actual" width="150" />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Cambiar Portada (Opcional)</label>
            <div class="col-md-10">
                <input type="file" name="ImagenArchivo" id="ImagenArchivo" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Actualizar" class="btn btn-primary" />
                @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}

