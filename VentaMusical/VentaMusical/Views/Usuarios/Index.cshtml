@model IEnumerable<VentaMusical.Models.ViewModels.Usuarios.ListarUsuarios>

@{
    ViewBag.Title = "Listado de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Listado de Usuarios</h2>
<br />
<br />

@if (ViewBag.ValorMensaje == 1)
{
    <div class="modal fade" id="myModal" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            onclick="document.location.href='@Url.Content("~/Usuarios/Index")'">
                        &times;
                    </button>
                    <h2 class="modal-title">Mensaje</h2>
                </div>
                <div class="modal-body">
                    <div class="alert alert-success">@ViewBag.MensajeProceso</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal"
                            onclick="document.location.href='@Url.Content("~/Usuarios/Index")'">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else if (ViewBag.ValorMensaje == 0)
{
    <div class="modal fade" id="myModal" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal">&times;</button>
                    <h2 class="modal-title">Mensaje</h2>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">@ViewBag.MensajeProceso</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@using (Html.BeginForm("Index", "Usuarios", FormMethod.Get))
{
    <div class="row mb-3">
        <div class="col-md-4 align-self-end text-end">
            <input type="button" class="btn btn-success w-100" value="Crear nuevo usuario"
                   onclick="document.location.href='@Url.Action("Create", "Usuarios")'" />
        </div>

        <div class="col-md-3">
            <label>Buscar por cedula:</label>
            @Html.TextBox("busquedaCedula", Request.QueryString["busquedaCedula"], new { @class = "form-control" })
        </div>

        <div class="col-md-2 align-self-end">
            <input type="submit" value="Buscar" class="btn btn-primary w-100" />
        </div>

    </div>
}

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Cedula</th>
            <th>Nombre</th>
            <th>Apellido</th>
            @*<th>Genero</th>*@
            <th>Correo</th>
            @*<th>Tipo Tarjeta</th>
            <th>Dinero Disponible</th>
            <th>Numero Tarjeta</th>
            <th>Contrasena</th>*@
            <th>Rol</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.NumeroIdentificacion</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                @*<td>@item.Genero</td>*@
                <td>@item.Correo</td>
                @*<td>@item.TipoTarjeta</td>
                <td>@item.DineroDisponible ₡</td>
                <td>@item.NumeroTarjeta</td>
                <td>@item.Contrasena</td>*@
                <td>@item.Perfil</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-primary btn-sm">Editar</a>
                    <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-success btn-sm">Detalles</a>
                    <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#myModal').modal('show');
        });
    </script>
}
