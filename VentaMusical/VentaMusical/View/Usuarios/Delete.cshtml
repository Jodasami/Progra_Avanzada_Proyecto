@model VentaMusical.Models.ViewModels.Usuarios.Usuario

@{
    ViewBag.Title = "Eliminar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Eliminar Usuario</h2>
<br />
<br />

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow-sm p-4">
            <h4 class="text-danger text-center mb-4">¿Estás seguro que deseas eliminar este producto?</h4>
            <dl class="row">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.IDUsuario)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IDUsuario)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NumeroIdentificacion)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.NumeroIdentificacion)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Apellido)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Apellido)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Genero)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Genero)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Correo)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Correo)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TipoTarjeta)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.TipoTarjeta)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DineroDisponible)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.DineroDisponible)₡</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NumeroTarjeta)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.NumeroTarjeta)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Contrasena)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Contrasena)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Perfil)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Perfil)</dd>
            </dl>

            @using (Html.BeginForm("Delete", "Usuarios", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="text-center mt-4">
                    <input type="submit" value="Eliminar" class="btn btn-danger btn-lg" />
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                </div>
            }
        </div>
    </div>
</div>
